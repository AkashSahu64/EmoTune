{
  "name": "emotune-server",
  "version": "2.0.0",
  "description": "Emotune AI-Powered Chat App Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --config jest.config.js --detectOpenHandles --forceExit",
    "test:watch": "jest --config jest.config.js --watch --detectOpenHandles --forceExit",
    "test:coverage": "jest --config jest.config.js --coverage --detectOpenHandles --forceExit",
    "test:identity": "jest --config jest.config.js tests/unit/identity tests/integration/identity --detectOpenHandles --forceExit",
    "worker:embedding": "node workers/embeddingWorker.js",
    "worker:intent": "node workers/intentWorker.js",
    "worker:truth": "node workers/truthWorker.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cloudinary": "^1.41.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.8",
    "mongoose": "^8.0.0",
    "nodemailer": "^6.9.16",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.0",
    "querystring": "^0.2.1",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
