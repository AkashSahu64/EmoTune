# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ─── MongoDB ────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/emotune

# ─── Redis (Cache + BullMQ + Rate Limiter) ─────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
RESPONSE_CACHE_TTL=300
SEMANTIC_CACHE_TTL=86400

# ─── Client URL ─────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ─── Google Gemini (Primary AI Provider) ────────────────
# Free tier: 1500 req/day, no credit card
# Uses newest FREE models automatically via discovery
# Fallback: gemini-2.5-flash → gemini-2.0-flash → gemini-1.5-flash
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TIMEOUT=4000
GEMINI_RETRIES=1
# Optional: override auto-discovery with explicit model list
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-1.5-flash

# ─── Groq (Secondary AI Provider) ───────────────────────
# Free tier: 14400 req/day, 30 req/min, no credit card
# Fallback: deepseek-r1 → llama-4 → qwen → llama-3.3
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=deepseek-r1-distill-llama-70b
GROQ_TIMEOUT=5000
GROQ_RETRIES=1
GROQ_MODELS=deepseek-r1-distill-llama-70b,llama-4-scout-17b-16e-instruct,qwen-2.5-72b,llama-3.3-70b-versatile

# ─── HuggingFace (Tertiary Fallback) ────────────────────
# Free inference API with rate limits
# Only used when Gemini + Groq both fail
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key
HF_BASE_URL=https://api-inference.huggingface.co/models
HF_DEFAULT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HF_TIMEOUT=8000

# ─── AI Settings ────────────────────────────────────────
AI_TIMEOUT=4000
AI_RETRIES=1
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7
AI_REQUESTS_PER_MIN=20
AI_BURST_SIZE=5
AI_REFILL_RATE=1
AI_REFILL_INTERVAL_MS=3000

# ─── Circuit Breaker ───────────────────────────────────
CB_FAILURE_THRESHOLD=3
CB_SUCCESS_THRESHOLD=2
CB_HALF_OPEN_MAX=1
CB_OPEN_TIMEOUT_MS=30000
HEALTH_CHECK_INTERVAL_MS=60000

# ─── Cloudinary (Media Storage) ────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret

# ─── YouTube Data API v3 (Free with quota) ──────────────
YOUTUBE_API_KEY=your_youtube_api_key

# ─── Pexels Video API (Free) ───────────────────────────
PEXELS_API_KEY=your_pexels_api_key

# ─── Pixabay Video API (Free) ──────────────────────────
PIXABAY_API_KEY=your_pixabay_api_key

# ─── Spotify API (Free tier) ───────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ─── JioSaavn Unofficial API (Free) ────────────────────
JIO_SAAVN_API=https://jiosaavn-api-unofficial.example.com

# ─── Giphy API (Free, for GIF suggestions) ─────────────
GIPHY_API_KEY=your_giphy_api_key

# ─── LibreTranslate (Free self-hosted or public instance)
LIBRETRANSLATE_URL=https://libretranslate.de

# ─── Google Fact Check Tools API ───────────────────────
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key
